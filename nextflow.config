// Default fallback values for params that may not be set in all user configs.
// User-provided -c configs override these.
params {
    qc_mad_filter              = false
    qc_mad_nmads               = 3.0
    integration_use_paga       = false
    integration_chunk_size     = 0
    integration_n_neighbors    = 15
    cell_caller                  = 'gmm'   // 'gmm' (splice-aware GMM) | 'emptydrops' (DropletUtils) | 'knee' (classic knee/shin barcode-rank, decontX-style)
    cell_calling_include_damaged = false
    cell_calling_alpha_dir       = ''      // dir of <sid>_alpha_hat.csv.gz; if set, drop is_cell with alpha>=max
    cell_calling_alpha_max       = 0.5
    run_cellsweep                = false
    cellsweep_n_empties          = 30000
    cellsweep_celltype_col       = 'RNA_snn_res.0.5'
}

// ============================================================================
// Execution profiles
// Select one with: -profile <name>  e.g. -profile offline
// ============================================================================
profiles {

    dsi {
        docker.enabled     = true
        docker.runOptions  = '-u $(id -u):$(id -g)'
        conda.enabled      = true
    }

    offline {
        docker.enabled     = true
        docker.runOptions  = '-u $(id -u):$(id -g)'
        conda.enabled      = true
        params.publish_mode_nonreport = 'symlink'
        params.publish_mode_reports = 'copy'
        process {
            cpus      = 100
            memory    = '200 GB'
            maxForks  = 16

            withLabel:process_single {
                cpus   = 1
                memory = { 6.GB * task.attempt }
                time   = { 4.h  * task.attempt }
            }
            withLabel:process_low {
                cpus   = { 2  * task.attempt }
                memory = { 12.GB * task.attempt }
                time   = { 2.h  * task.attempt }
            }
            withLabel:process_medium {
                cpus   = { 9  * task.attempt }
                memory = { 36.GB * task.attempt }
                time   = { 9.h  * task.attempt }
            }
            withLabel:process_high {
                cpus   = { 60 * task.attempt }
                memory = { 120.GB * task.attempt }
                time   = { 14.h * task.attempt }
            }
            withName:RUN_SINGLER_REFERENCE_ANNOTATION {
                cpus   = 8
            }
            withLabel:process_cellbender {
                cpus   = { 64 * task.attempt }
                memory = { 200.GB * task.attempt }
                time   = { 24.h * task.attempt }
            }
            withLabel:process_long {
                cpus   = 9
                memory = 96.GB
                time   = { 14.h * task.attempt }
            }
            withLabel:process_high_memory {
                cpus   = { 40 * task.attempt }
                memory = { 200.GB * task.attempt }
                time   = { 24.h * task.attempt }
            }
            withLabel:process_higher_memory {
                cpus   = { 20 * task.attempt }
                memory = { 200.GB * task.attempt }
                time   = { 12.h * task.attempt }
            }
            withLabel:process_simpleaf {
                cpus   = { 16 * task.attempt }
                memory = { 40.GB * task.attempt }
                time   = { 12.h * task.attempt }
            }
            withLabel:process_cellranger {
                cpus   = { 16 * task.attempt }
                memory = { 150.GB * task.attempt }
                time   = { 24.h * task.attempt }
            }
            withLabel:process_gpu {
                cpus   = 10
                memory = '120.GB'
                time   = '4.h'
            }
            withLabel:process_seurat {
                cpus   = 10
                memory = '80.GB'
                time   = '1.h'
            }
            withLabel:process_reports {
                cpus   = 20
                memory = '80.GB'
                time   = '2.h'
            }
            withLabel:process_dropletqc {
                cpus   = { 16 * task.attempt }
                memory = '80.GB'
                time   = '2.h'
            }
        }
    }

    imperial {
        report.overwrite = true
        docker.enabled   = false
        conda.enabled    = true
        singularity {
            enabled    = true
            autoMounts = true
            runOptions = '--nv'
            cacheDir   = '/rds/general/user/ah3918/home/singularity_cache'
        }
        process {
            executor      = 'pbspro'
            errorStrategy = 'retry'
            maxRetries    = 5
            maxErrors     = '-1'
            queue         = { task.attempt > 2 ? 'v1_small72' : 'v1_small24' }
            cpus          = { 1  * task.attempt }
            memory        = { 6.GB  * task.attempt }
            time          = { 4.h   * task.attempt }

            withLabel:process_single {
                cpus   = 1
                memory = { 6.GB * task.attempt }
                time   = { 4.h  * task.attempt }
            }
            withLabel:process_low {
                cpus   = { 2  * task.attempt }
                memory = { 12.GB * task.attempt }
                time   = { 2.h  * task.attempt }
            }
            withLabel:process_medium {
                queue  = 'v1_medium72'
                cpus   = { 9  * task.attempt }
                memory = { 36.GB * task.attempt }
                time   = { 9.h  * task.attempt }
            }
            withLabel:process_high {
                queue  = 'v1_medium72'
                cpus   = { 16 * task.attempt }
                memory = { 72.GB * task.attempt }
                time   = { 14.h * task.attempt }
            }
            withName:RUN_SINGLER_REFERENCE_ANNOTATION {
                cpus   = 8
            }
            withLabel:process_cellbender {
                queue  = 'v1_medium24'
                cpus   = { 64 * task.attempt }
                memory = { 200.GB * task.attempt }
                time   = { 24.h * task.attempt }
            }
            withLabel:process_long {
                queue  = 'v1_medium72'
                cpus   = 9
                memory = 96.GB
                time   = { 14.h * task.attempt }
            }
            withLabel:process_high_memory {
                queue  = { 200 * task.attempt < 921 ? 'v1_medium72' : 'v1_largemem72' }
                cpus   = { 40 * task.attempt }
                memory = { 200.GB * task.attempt }
                time   = { 24.h * task.attempt }
            }
            withLabel:process_higher_memory {
                queue  = { 200 * task.attempt < 921 ? 'v1_medium72' : 'v1_largemem72' }
                cpus   = { 20 * task.attempt }
                memory = { 400.GB * task.attempt }
                time   = { 12.h * task.attempt }
            }

            withLabel:process_cellranger{
                queue  = { 200 * task.attempt < 921 ? 'v1_medium72' : 'v1_largemem72' }
                cpus   = { 20 * task.attempt }
                memory = { 400.GB * task.attempt }
                time   = { 12.h * task.attempt }
            }
            withLabel:process_simpleaf {
                queue  = 'v1_medium72'
                cpus   = { 16 * task.attempt }
                memory = { 80.GB * task.attempt }
                time   = { 12.h * task.attempt }
            }
            withLabel:process_gpu {
                queue          = 'v1_gpu72'
                cpus           = 10
                memory         = '120.GB'
                time           = '6.h'
                clusterOptions = '-l select=1:ncpus=10:mem=120gb:ngpus=1:gpu_type=RTX6000'
            }
            withLabel:process_seurat {
                queue  = 'v1_medium24'
                cpus   = 30
                memory = '80.GB'
                time   = '2.h'
            }
            withLabel:process_reports {
                queue  = 'v1_medium24'
                cpus   = 20
                memory = '100.GB'
                time   = '2.h'
            }
            withLabel:process_dropletqc {
                queue  = 'v1_medium24'
                cpus   = { 16 * task.attempt }
                memory = '80.GB'
                time   = '2.h'
            }
        }
    }

    slurm {
        docker.enabled     = true
        docker.runOptions  = '-u $(id -u):$(id -g)'
        conda.enabled      = true
        process {
            executor = 'slurm'
            queue    = 'debug'

            withLabel:process_cellbender {
                cpus           = { 120 * task.attempt }
                memory         = { 280.GB * task.attempt }
                clusterOptions = '--exclude=landmark-lv-01'
                scratch        = '/mnt/share/alex/tmp'
                beforeScript   = '''
                    export TMPDIR=/mnt/share/alex/tmp
                    export CELLRANGER_TMPDIR=/mnt/share/alex/tmp
                    export TMP=/mnt/share/alex/tmp
                    export TEMP=/mnt/share/alex/tmp
                    mkdir -p $TMPDIR
                '''
            }
            withLabel:process_long {
                cpus           = 9
                memory         = 96.GB
                time           = { 14.h * task.attempt }
                clusterOptions = '--exclude=landmark-lv-01'
                scratch        = '/mnt/share/alex/tmp'
                beforeScript   = '''
                    export TMPDIR=/mnt/share/alex/tmp
                    export TMP=/mnt/share/alex/tmp
                    export TEMP=/mnt/share/alex/tmp
                    mkdir -p $TMPDIR
                '''
            }
            withLabel:process_high_memory {
                cpus           = { 40 * task.attempt }
                memory         = { 200.GB * task.attempt }
                time           = { 24.h * task.attempt }
                clusterOptions = '--exclude=landmark-lv-01'
                scratch        = '/mnt/share/alex/tmp'
                beforeScript   = '''
                    export TMPDIR=/mnt/share/alex/tmp
                    export CELLRANGER_TMPDIR=/mnt/share/alex/tmp
                    export TMP=/mnt/share/alex/tmp
                    export TEMP=/mnt/share/alex/tmp
                    mkdir -p $TMPDIR
                '''
            }
            withName:RUN_SINGLER_REFERENCE_ANNOTATION {
                cpus           = 8
            }
            withLabel:process_higher_memory {
                cpus           = 30
                memory         = 280.GB
                clusterOptions = '--exclude=landmark-lv-01'
                scratch        = '/mnt/share/alex/tmp'
                beforeScript   = '''
                    export TMPDIR=/mnt/share/alex/tmp
                    export CELLRANGER_TMPDIR=/mnt/share/alex/tmp
                    export TMP=/mnt/share/alex/tmp
                    export TEMP=/mnt/share/alex/tmp
                    mkdir -p $TMPDIR
                '''
            }
            withLabel:process_simpleaf {
                cpus           = 16
                memory         = '80.GB'
                time           = '12.h'
                clusterOptions = '--exclude=landmark-lv-01'
                scratch        = '/mnt/share/alex/tmp'
                beforeScript   = '''
                    export TMPDIR=/mnt/share/alex/tmp
                    export TMP=/mnt/share/alex/tmp
                    export TEMP=/mnt/share/alex/tmp
                    mkdir -p $TMPDIR
                '''
            }
            withLabel:process_gpu {
                cpus           = 10
                memory         = '120.GB'
                time           = '4.h'
                clusterOptions = '--exclude=landmark-lv-01 --gres=gpu:1'
                scratch        = '/mnt/share/alex/tmp'
                beforeScript   = '''
                    export TMPDIR=/mnt/share/alex/tmp
                    export TMP=/mnt/share/alex/tmp
                    export TEMP=/mnt/share/alex/tmp
                    mkdir -p $TMPDIR
                '''
            }
            withLabel:process_reports {
                cpus           = 16
                memory         = '30.GB'
                time           = '1.h'
                clusterOptions = '--exclude=landmark-lv-01'
                scratch        = '/mnt/share/alex/tmp'
                beforeScript   = '''
                    export TMPDIR=/mnt/share/alex/tmp
                    export TMP=/mnt/share/alex/tmp
                    export TEMP=/mnt/share/alex/tmp
                    mkdir -p $TMPDIR
                '''
            }
            withLabel:process_dropletqc {
                cpus           = 30
                memory         = '80.GB'
                time           = '2.h'
                clusterOptions = '--exclude=landmark-lv-01'
                beforeScript   = '''
                    export TMPDIR=/mnt/share/alex/tmp
                    export TMP=/mnt/share/alex/tmp
                    export TEMP=/mnt/share/alex/tmp
                    mkdir -p $TMPDIR
                '''
            }
        }
    }

}

// ============================================================================
// Second-pass (post-CellSweep) output routing.
// The *_P2 aliases reuse pass-1 process bodies (same hardcoded publishDir);
// these withName selectors override that so pass-2 outputs land in
// outputDir/pass2/* and do not clobber the pass-1 outputs. (Config publishDir
// overrides the process-body publishDir for the selected name.)
// ============================================================================
process {
    withName: 'HVG_SELECTION_P2' {
        publishDir = [path: { "${params.outputDir}/pass2/hvg" }, mode: 'copy', overwrite: true]
    }
    withName: 'RUN_INTEGRATION_P2' {
        publishDir = [path: { "${params.outputDir}/pass2/integration" }, mode: 'copy', overwrite: true]
    }
    withName: 'HVG_REPORT_P2|INTEGRATION_REPORT_P2' {
        publishDir = [path: { "${params.outputDir}/pass2/reports" }, mode: 'copy', overwrite: true]
    }
    withName: '.*ANNOTATION_P2:.*|.*ANNOTATION_METHODS_P2:.*' {
        publishDir = [path: { "${params.outputDir}/pass2/annotation" }, mode: 'copy', overwrite: true]
    }
}

