// Default fallback values for params that may not be set in all user configs.
// User-provided -c configs override these.
params {
    qc_mad_filter              = false
    qc_mad_nmads               = 3.0
    integration_use_paga       = false
    integration_chunk_size     = 0
    integration_n_neighbors    = 15
    cell_caller                  = 'gmm'   // 'gmm' (splice-aware GMM) | 'emptydrops' (DropletUtils) | 'knee' (classic knee/shin barcode-rank, decontX-style)
    cell_calling_include_damaged = false
    // Sample-quality separability flag (soft; reporting only, no cells dropped).
    // Bhattacharyya distance between the fitted GMM ambient/nuclei Gaussians.
    cc_bhattacharyya_warn        = 2.3     // WARN below this (borderline ambient/nuclei separation)
    cc_bhattacharyya_fail        = 1.5     // FAIL below this (collapsed separation — distrust calls)
    soup_cosine_flag             = 0.93    // CellSweep report: flag soup≈dominant-cell-type (α̂ unidentifiable)
    ambient_empty_umi_cap        = 0       // AMBIENT_DE empties band upper UMI bound; 0 = knee empty plateau only
    cell_calling_alpha_dir       = ''      // dir of <sid>_alpha_hat.csv.gz; if set, drop is_cell with alpha>=max
    cell_calling_alpha_max       = 0.5
    ambient_method                = 'none' // 'none' | 'cellsweep'
    cellsweep_n_empties           = 30000
    cellsweep_celltype_col        = 'RNA_snn_res.0.2'  // per-sample Leiden resolution column feeding CellSweep
    cellsweep_annotation_method_id = ''    // id in annotation_methods (engine: xgboost) supplying per-sample labels;
                                            // if blank, defaults to the sole configured xgboost method
    cellsweep_report_n_worst        = 20    // cellsweep_report: per-sample detail tabs for the N highest-ambient-
                                             // burden samples ('all' for no cap)
    cellsweep_report_n_best         = 20    // cellsweep_report: per-sample detail tabs for the N lowest-ambient-
                                             // burden samples ('all' for no cap)
    cellsweep_report_focus_samples  = ''    // space/comma-separated sample_id(s) always given a detail tab too,
                                             // regardless of n_worst/n_best
    harmony_impl                   = 'harmonypy'  // 'harmonypy' (default, Python) | 'harmony2' (R harmony >=2.0, scalable)
    harmony2_lib                   = ''  // optional external R lib for harmony >=2.0; empty = use container image's harmony
}

// ============================================================================
// Execution profiles
// Select one with: -profile <name>  e.g. -profile offline
// ============================================================================
profiles {

    dsi {
        docker.enabled     = true
        docker.runOptions  = '-u $(id -u):$(id -g)'
        conda.enabled      = true
    }

    offline {
        docker.enabled     = true
        docker.runOptions  = '-u $(id -u):$(id -g)'
        conda.enabled      = true
        params.publish_mode_nonreport = 'symlink'
        params.publish_mode_reports = 'copy'
        process {
            cpus      = 100
            memory    = '200 GB'
            maxForks  = 16
            errorStrategy = 'retry'
            maxRetries    = 3
            maxErrors     = '-1'

            withLabel:process_single {
                cpus   = 1
                memory = { 6.GB * task.attempt }
                time   = { 4.h  * task.attempt }
            }
            withLabel:process_low {
                cpus   = { 2  * task.attempt }
                memory = { 12.GB * task.attempt }
                time   = { 2.h  * task.attempt }
            }
            withLabel:process_medium {
                cpus   = { 9  * task.attempt }
                memory = { 36.GB * task.attempt }
                time   = { 9.h  * task.attempt }
            }
            withLabel:process_high {
                cpus   = { 60 * task.attempt }
                memory = { 120.GB * task.attempt }
                time   = { 14.h * task.attempt }
            }
            withLabel:process_dblfinder {
                cpus   = { 4  * task.attempt }
                memory = { 28.GB * task.attempt }
                time   = { 6.h  * task.attempt }
            }
            withName:RUN_SINGLER_REFERENCE_ANNOTATION {
                cpus   = 8
            }
            withLabel:process_cellbender {
                cpus   = { 64 * task.attempt }
                memory = { 200.GB * task.attempt }
                time   = { 24.h * task.attempt }
            }
            withLabel:process_long {
                cpus   = 9
                memory = 96.GB
                time   = { 14.h * task.attempt }
            }
            withLabel:process_high_memory {
                cpus   = { 40 * task.attempt }
                memory = { 200.GB * task.attempt }
                time   = { 24.h * task.attempt }
            }
            withLabel:process_higher_memory {
                cpus   = { 20 * task.attempt }
                memory = { 200.GB * task.attempt }
                time   = { 12.h * task.attempt }
            }
            withLabel:process_simpleaf {
                cpus   = { 16 * task.attempt }
                memory = { 40.GB * task.attempt }
                time   = { 12.h * task.attempt }
            }
            withLabel:process_cellranger {
                cpus   = { 16 * task.attempt }
                memory = { 150.GB * task.attempt }
                time   = { 24.h * task.attempt }
            }
            withLabel:process_gpu {
                cpus   = 10
                memory = '120.GB'
                time   = '4.h'
            }
            withLabel:process_seurat {
                cpus   = 10
                memory = '80.GB'
                time   = '1.h'
            }
            withLabel:process_reports {
                cpus   = 20
                memory = '80.GB'
                time   = { 2.h * task.attempt }
            }
            withLabel:process_dropletqc {
                cpus   = { 16 * task.attempt }
                memory = '80.GB'
                time   = '2.h'
            }
        }
    }

    imperial {
        report.overwrite = true
        docker.enabled   = false
        conda.enabled    = true
        singularity {
            enabled    = true
            autoMounts = true
            runOptions = '--nv'
            cacheDir   = '/rds/general/user/ah3918/home/singularity_cache'
        }
        process {
            executor      = 'pbspro'
            errorStrategy = 'retry'
            maxRetries    = 5
            maxErrors     = '-1'
            queue         = { task.attempt > 2 ? 'v1_small72' : 'v1_small24' }
            cpus          = { 1  * task.attempt }
            memory        = { 6.GB  * task.attempt }
            time          = { 4.h   * task.attempt }

            withLabel:process_single {
                cpus   = 1
                memory = { 6.GB * task.attempt }
                time   = { 4.h  * task.attempt }
            }
            withLabel:process_low {
                cpus   = { 2  * task.attempt }
                memory = { 12.GB * task.attempt }
                time   = { 2.h  * task.attempt }
            }
            withLabel:process_medium {
                queue  = 'v1_medium72'
                cpus   = { 9  * task.attempt }
                memory = { 36.GB * task.attempt }
                time   = { 9.h  * task.attempt }
            }
            withLabel:process_high {
                queue  = 'v1_medium72'
                cpus   = { 16 * task.attempt }
                memory = { 72.GB * task.attempt }
                time   = { 14.h * task.attempt }
            }
            withLabel:process_dblfinder {
                // No explicit queue: inherits the profile default
                // (v1_small24 -> v1_small72 on retry). 4 cpu / 28 GB fits the
                // small queue; the v1_medium* queues require higher min cpus.
                cpus   = { 4  * task.attempt }
                memory = { 28.GB * task.attempt }
                time   = { 6.h  * task.attempt }
            }
            withName:RUN_SINGLER_REFERENCE_ANNOTATION {
                cpus   = 8
            }
            withLabel:process_cellbender {
                queue  = 'v1_medium24'
                cpus   = { 64 * task.attempt }
                memory = { 200.GB * task.attempt }
                time   = { 24.h * task.attempt }
            }
            withLabel:process_long {
                queue  = 'v1_medium72'
                cpus   = 9
                memory = 96.GB
                time   = { 14.h * task.attempt }
            }
            withLabel:process_high_memory {
                queue  = { 200 * task.attempt < 921 ? 'v1_medium72' : 'v1_largemem72' }
                cpus   = { 40 * task.attempt }
                memory = { 200.GB * task.attempt }
                time   = { 24.h * task.attempt }
            }
            withLabel:process_higher_memory {
                queue  = { 200 * task.attempt < 921 ? 'v1_medium72' : 'v1_largemem72' }
                cpus   = { 20 * task.attempt }
                memory = { 400.GB * task.attempt }
                time   = { 12.h * task.attempt }
            }

            withLabel:process_cellranger{
                queue  = { 200 * task.attempt < 921 ? 'v1_medium72' : 'v1_largemem72' }
                cpus   = { 20 * task.attempt }
                memory = { 400.GB * task.attempt }
                time   = { 12.h * task.attempt }
            }
            withLabel:process_simpleaf {
                queue  = 'v1_medium72'
                cpus   = { 16 * task.attempt }
                memory = { 80.GB * task.attempt }
                time   = { 12.h * task.attempt }
            }
            withLabel:process_gpu {
                queue          = 'v1_gpu72'
                cpus           = 10
                memory         = '120.GB'
                time           = '6.h'
                clusterOptions = '-l select=1:ncpus=10:mem=120gb:ngpus=1:gpu_type=RTX6000'
            }
            withLabel:process_seurat {
                queue  = 'v1_medium24'
                cpus   = 30
                memory = '80.GB'
                time   = '2.h'
            }
            withLabel:process_reports {
                queue  = 'v1_medium24'
                cpus   = 20
                memory = '100.GB'
                time   = { 2.h * task.attempt }
            }
            withLabel:process_dropletqc {
                queue  = 'v1_medium24'
                cpus   = { 16 * task.attempt }
                memory = '80.GB'
                time   = '2.h'
            }
        }
    }

    slurm {
        docker.enabled     = true
        docker.runOptions  = '-u $(id -u):$(id -g)'
        conda.enabled      = true
        process {
            executor = 'slurm'
            queue    = 'debug'

            withLabel:process_cellbender {
                cpus           = { 120 * task.attempt }
                memory         = { 280.GB * task.attempt }
                clusterOptions = '--exclude=landmark-lv-01'
                scratch        = '/mnt/share/alex/tmp'
                beforeScript   = '''
                    export TMPDIR=/mnt/share/alex/tmp
                    export CELLRANGER_TMPDIR=/mnt/share/alex/tmp
                    export TMP=/mnt/share/alex/tmp
                    export TEMP=/mnt/share/alex/tmp
                    mkdir -p $TMPDIR
                '''
            }
            withLabel:process_long {
                cpus           = 9
                memory         = 96.GB
                time           = { 14.h * task.attempt }
                clusterOptions = '--exclude=landmark-lv-01'
                scratch        = '/mnt/share/alex/tmp'
                beforeScript   = '''
                    export TMPDIR=/mnt/share/alex/tmp
                    export TMP=/mnt/share/alex/tmp
                    export TEMP=/mnt/share/alex/tmp
                    mkdir -p $TMPDIR
                '''
            }
            withLabel:process_high_memory {
                cpus           = { 40 * task.attempt }
                memory         = { 200.GB * task.attempt }
                time           = { 24.h * task.attempt }
                clusterOptions = '--exclude=landmark-lv-01'
                scratch        = '/mnt/share/alex/tmp'
                beforeScript   = '''
                    export TMPDIR=/mnt/share/alex/tmp
                    export CELLRANGER_TMPDIR=/mnt/share/alex/tmp
                    export TMP=/mnt/share/alex/tmp
                    export TEMP=/mnt/share/alex/tmp
                    mkdir -p $TMPDIR
                '''
            }
            withName:RUN_SINGLER_REFERENCE_ANNOTATION {
                cpus           = 8
            }
            withLabel:process_higher_memory {
                cpus           = 30
                memory         = 280.GB
                clusterOptions = '--exclude=landmark-lv-01'
                scratch        = '/mnt/share/alex/tmp'
                beforeScript   = '''
                    export TMPDIR=/mnt/share/alex/tmp
                    export CELLRANGER_TMPDIR=/mnt/share/alex/tmp
                    export TMP=/mnt/share/alex/tmp
                    export TEMP=/mnt/share/alex/tmp
                    mkdir -p $TMPDIR
                '''
            }
            withLabel:process_simpleaf {
                cpus           = 16
                memory         = '80.GB'
                time           = '12.h'
                clusterOptions = '--exclude=landmark-lv-01'
                scratch        = '/mnt/share/alex/tmp'
                beforeScript   = '''
                    export TMPDIR=/mnt/share/alex/tmp
                    export TMP=/mnt/share/alex/tmp
                    export TEMP=/mnt/share/alex/tmp
                    mkdir -p $TMPDIR
                '''
            }
            withLabel:process_gpu {
                cpus           = 10
                memory         = '120.GB'
                time           = '4.h'
                clusterOptions = '--exclude=landmark-lv-01 --gres=gpu:1'
                scratch        = '/mnt/share/alex/tmp'
                beforeScript   = '''
                    export TMPDIR=/mnt/share/alex/tmp
                    export TMP=/mnt/share/alex/tmp
                    export TEMP=/mnt/share/alex/tmp
                    mkdir -p $TMPDIR
                '''
            }
            withLabel:process_reports {
                cpus           = 16
                memory         = '30.GB'
                time           = { 1.h * task.attempt }
                clusterOptions = '--exclude=landmark-lv-01'
                scratch        = '/mnt/share/alex/tmp'
                beforeScript   = '''
                    export TMPDIR=/mnt/share/alex/tmp
                    export TMP=/mnt/share/alex/tmp
                    export TEMP=/mnt/share/alex/tmp
                    mkdir -p $TMPDIR
                '''
            }
            withLabel:process_dropletqc {
                cpus           = 30
                memory         = '80.GB'
                time           = '2.h'
                clusterOptions = '--exclude=landmark-lv-01'
                beforeScript   = '''
                    export TMPDIR=/mnt/share/alex/tmp
                    export TMP=/mnt/share/alex/tmp
                    export TEMP=/mnt/share/alex/tmp
                    mkdir -p $TMPDIR
                '''
            }
        }
    }

}

