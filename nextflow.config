// ============================================================================
// Central run configuration (single source of truth)
// Override any value with CLI flags, e.g. --run_mode mapping
// ============================================================================
params {
    run_mode       = 'qc'          // mapping | qc | both
    mapper         = 'cellranger'  // supported: cellranger, alevinfry

    // Input discovery
    raw_data_dir   = null          // required for mapping/both; each subdir is one sample
    mapped_data_dir = null         // required for qc; each subdir is one mapped sample

    // Cell Ranger mapping resources
    cellrangerPath = null          // required for cellranger mapping
    transcriptome  = null          // required for cellranger mapping

    // alevin-fry / simpleaf mapping resources
    alevinfry_index       = null   // pre-built simpleaf index dir (contains index/ subdir)
    alevinfry_t2g         = null   // transcript-to-gene map (t2g_3col.tsv)
    alevinfry_whitelist   = null   // optional whitelist override; if null, derive from Cell Ranger barcodes using chemistry
    alevinfry_chemistry   = null   // required for alevinfry mapping (use explicit chemistries: 3v2, 5v1, 5v2, 3v3, 5v3, 3v4, 3LT, multiome)
    alevinfry_orientation = 'auto' // expected read orientation (auto, fw, rc, both)
    alevinfry_fasta       = null   // reference FASTA for index building (if no pre-built index)
    alevinfry_gtf         = null   // reference GTF for index building (if no pre-built index)
    mapping_cpus          = 60     // CPUs for SIMPLEAF index/quant (override with --mapping_cpus)
    qc_cpus               = 30     // CPUs for QC processes (emptyDrops, decontX, DropletQC; override with --qc_cpus)

    // QC and downstream behavior
    ambient_method = 'decontx'   // 'decontx' (CPU) or 'cellbender' (GPU-optional)
    gpu            = false        // enable GPU for cellbender ambient_method
    max_mito       = 20.0
    min_nuclear    = 0.4
    max_nuclear    = 1.0          // upper nuclear fraction filter (1.0 = no upper filter)
    metadata       = null

    // Outputs and reporting
    outputDir      = 'results'
    report         = true
    book           = false
    help           = false
    trace_report_suffix = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
}

// Conda channel configuration for tools like simpleaf/alevin-fry.
// Keep conda-forge ahead of bioconda for dependency resolution.
conda {
    channels = ['conda-forge', 'bioconda', 'defaults']
}

// Execution profiles (compute environments, resource labels)
// See configs/profiles.config to add or modify profiles.
includeConfig 'configs/profiles.config'

// ============================================================================
// EXECUTION ARTIFACT REPORTING
// ============================================================================
// Collect execution logs, timelines, traces, and DAG into a dedicated folder
// within the output directory for easy audit and debugging.

timeline {
    enabled = true
    file = "${params.outputDir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}

report {
    enabled = true
    file = "${params.outputDir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}

trace {
    enabled = true
    file = "${params.outputDir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}

dag {
    enabled = true
    file = "${params.outputDir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}