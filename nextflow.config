// ============================================================================
// Central run configuration
// Override any value with CLI flags, e.g. --outputDir results/
// ============================================================================
params {
    // Input / output
    raw_data_dir    = null      // parent dir; each subdir is one sample (required)
    outputDir       = 'results'
    siteDir         = "results/site"  // optional secondary publish dir for the assembled site bundle
    help            = false

    // Cell Ranger install (required) — whitelists are extracted from here
    cellrangerPath  = null      // e.g. /path/to/cellranger-9.0.0

    // Reference genome (required) — used to build simpleaf index
    genome_fasta    = null      // reference FASTA
    genome_gtf      = null      // reference GTF

    // 10x chemistry (default: 3v4)
    // Accepted values: 3v2, 3v3, 3v4, 3LT, 5v1, 5v2, 5v3, multiome
    chemistry       = '3v4'

    // Workflow control
    build_site      = true   // set to false to skip final assembled report site bundle
    run_ambient     = true   // set to false to skip AMBIENT
    run_qc          = true   // set to false to skip QC (requires run_ambient)
    run_hvg         = true   // set to false to skip HVG selection (requires run_qc)
    run_integration = true   // set to false to skip integration (requires run_hvg)
    run_annotation  = true // set to true to run marker-based annotation (requires run_integration)

    // HVG selection
    hvg_n_hvgs      = 2000   // number of highly variable genes to select

    // Barcode caller v2 (standalone audit only)
    barcode_v2_min_umis_empty = 5
    barcode_v2_ed_niters = 10000
    barcode_v2_ed_fdr = 0.001
    barcode_v2_splice_context = 'snrna'
    barcode_v2_low_count_strategy = 'shin2'

    // Integration — metadata
    metadata_csv     = '/mnt/data/projects/mini-landmark/metadata/metadataFull.csv' // path to metadata CSV (required when run_integration = true)
    metadata_id_col  = 'experimentid'  // column in metadata CSV mapping to sample IDs
    metadata_vars    = "brainregion condition brainbank ageatdeath gender"  // space-separated columns for Harmony correction (e.g. 'brainregion condition')

    // Integration — Harmony / clustering / UMAP
    integration_n_dims    = 50    // number of PCA dimensions
    integration_theta     = 0.1   // Harmony theta (diversity penalty)
    integration_leiden_res = '0.1 0.2 0.5 1.0 2.0'  // space-separated Leiden resolutions
    integration_dbl_res   = 4.0   // Leiden resolution for doublet detection pass (high)
    integration_dbl_cl_prop = 0.5 // doublet proportion threshold for cluster exclusion
    exclude_mito          = true  // exclude mito counts from library size denominator

    // Annotation
    annotation_marker_csv = "${projectDir}/dev/test_annotation_markers.csv"  // long-format CSV: label/symbol or cell_type/marker_gene
    annotation_sel_res = '0.2'    // single clustering resolution from integration_dt.csv.gz
    annotation_min_cl_size = 100
    annotation_min_cells = 10
    annotation_not_ok_re = '(lincRNA|lncRNA|pseudogene|antisense)'
    annotation_min_cpm_mkr = 50
    annotation_top_n = 10
    annotation_fdr_cut = 0.01
    annotation_max_zero_p = 0.5

    // QC thresholds — hard baseline (very permissive, removes obvious junk)
    qc_hard_min_counts = 200
    qc_hard_min_feats  = 100
    qc_hard_max_mito   = 0.5

    // QC thresholds — soft per-sample (more stringent)
    qc_min_counts  = 500
    qc_min_feats   = 300
    qc_max_mito    = 0.2
    qc_min_mito    = 0
    qc_max_splice  = 0.6
    qc_min_splice  = 0

    // Execution tuning
    trace_report_suffix = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
}

// Conda channel configuration for tools like simpleaf/alevin-fry.
// Keep conda-forge ahead of bioconda for dependency resolution.
conda {
    channels = ['conda-forge', 'bioconda', 'defaults']
}

// Execution profiles (compute environments, resource labels)
// See configs/profiles.config to add or modify profiles.
includeConfig 'configs/profiles.config'

// ============================================================================
// EXECUTION ARTIFACT REPORTING
// ============================================================================
// Collect execution logs, timelines, traces, and DAG into a dedicated folder
// within the output directory for easy audit and debugging.

timeline {
    enabled = true
    file = "${params.outputDir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}

report {
    enabled = true
    file = "${params.outputDir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}

trace {
    enabled = true
    file = "${params.outputDir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}

dag {
    enabled = true
    file = "${params.outputDir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}
