// ============================================================================
// Run configuration template
// Copy this file to a local config (for example personal/run.config) and edit
// the path values for your environment before running the pipeline.
// Override any value with CLI flags if needed.
// ============================================================================
params {
    // Input / output
    raw_data_dir    = null      // required: parent dir; each subdir is one sample
    outputDir       = 'results'
    publish_mode_nonreport = 'copy'
    publish_mode_reports = 'copy'
    publish_mapping_simpleaf = false // publish large simpleaf af_quant mapping outputs to outputDir/mapping
    help            = false

    // Cell Ranger install (required) — whitelists are extracted from here
    cellrangerPath  = null      // e.g. /path/to/cellranger-10.0.0

    // Reference genome (required) — used to build simpleaf index
    genome_fasta    = null      // reference FASTA
    genome_gtf      = null      // reference GTF

    // 10x chemistry (default: 3v4)
    // Accepted values: 3v2, 3v3, 3v4, 3LT, 5v1, 5v2, 5v3, multiome
    chemistry       = '3v4'

    // Workflow control
    run_ambient     = true
    run_qc          = true
    run_hvg         = true
    run_integration = true
    run_annotation  = true
    export          = 'none' // none, anndata, seurat, both
    export_write_combined = true

    // HVG selection
    hvg_n_hvgs      = 2000

    // Ambient method / CellBender tuning
    ambient_method = 'decontx'  // decontx or cellbender
    cellbender_env_name = 'cellbender'
    cellbender_mig_device = ''
    cellbender_expected_cells = 0
    cellbender_total_droplets_included = 0
    cellbender_low_count_threshold = 0
    cellbender_learning_rate = 0.0001
    cellbender_empty_drop_training_fraction = 0.2
    cellbender_posterior_batch_size = 0

    // Integration — metadata
    metadata_csv     = null     // required when run_integration = true
    metadata_id_col  = 'experimentid'
    metadata_vars    = "brainregion condition brainbank ageatdeath gender"

    // Integration — Harmony / clustering / UMAP
    integration_n_dims    = 50
    integration_theta     = 0.1
    integration_leiden_res = '0.1 0.2 0.5 1.0 2.0'
    integration_cluster_seed = 42
    integration_dbl_res   = 4.0
    integration_dbl_cl_prop = 0.5
    exclude_mito          = true

    // Annotation
    annotation_marker_csv = "${projectDir}/dev/test_annotation_markers.csv"
    annotation_sel_res = '0.2'
    annotation_min_cl_size = 100
    annotation_min_cells = 10
    annotation_not_ok_re = '(lincRNA|lncRNA|pseudogene|antisense)'
    annotation_min_cpm_mkr = 50
    annotation_top_n = 10
    annotation_fdr_cut = 0.01
    annotation_max_zero_p = 0.5

    // Zoomed subset reruns
    zoom = [
        enabled: true,
        default_sample_min_cells: 10,
        default_hvg_n_hvgs: 2000,
        default_cluster_res: '0.2',
        default_integration_n_dims: 50,
        default_integration_theta: 0.1,
        default_integration_leiden_res: '0.2 0.5 1.0',
        default_integration_dbl_res: 4.0,
        default_integration_dbl_cl_prop: 0.5,
        default_exclude_mito: true,
        default_marker_sel_res: '0.2',
        default_marker_min_cl_size: 100,
        default_marker_min_cells: 10,
        default_marker_top_n: 10,
        default_marker_min_cpm: 50,
        default_marker_fdr_cut: 0.01,
        default_marker_max_zero_p: 0.5,
        items: [
            [
                name: 'dopaminergic_neurons',
                source: 'annotation_label'
            ],
            // [name: 'cl01_cl02', source: 'cluster', cluster_res: '0.2', values: ['cl01', 'cl02']]
        ]
    ]

    // QC thresholds — hard baseline
    qc_hard_min_counts = 200
    qc_hard_min_feats  = 100
    qc_hard_max_mito   = 0.5

    // QC thresholds — soft per-sample
    qc_min_counts  = 500
    qc_min_feats   = 300
    qc_max_mito    = 0.2
    qc_min_mito    = 0
    qc_max_splice  = 0.6
    qc_min_splice  = 0

    // Execution tuning
    trace_report_suffix = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
}

conda {
    channels = ['conda-forge', 'bioconda', 'defaults']
}

timeline {
    enabled = true
    file = "${params.outputDir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}

report {
    enabled = true
    file = "${params.outputDir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}

trace {
    enabled = true
    file = "${params.outputDir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}

dag {
    enabled = true
    file = "${params.outputDir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}
