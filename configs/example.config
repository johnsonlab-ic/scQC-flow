// ============================================================================
// Central run configuration
// Override any value with CLI flags, e.g. --outputDir results/
// ============================================================================
params {
    // Input / output
    raw_data_dir    = '/data/ah3918/projects/scQC-flow/data/raw'   // parent dir; each subdir is one sample (required)
    outputDir       = '/data/ah3918/projects/scQC-flow/data/scqc_test_results'
    publish_mode_nonreport = 'copy'
    publish_mode_reports = 'copy'
    help            = false

    // Cell Ranger install (required) — whitelists are extracted from here
    cellrangerPath  = "/data/ah3918/projects/scQC-flow/data/resources/downloads/cellranger-10.0.0/"      // e.g. /path/to/cellranger-9.0.0

    // Reference genome (required) — used to build simpleaf index
    genome_fasta    = "/data/ah3918/projects/scQC-flow/data/resources/downloads/refdata-gex-GRCh38-2024-A/fasta/genome.fa"     // reference FASTA
    genome_gtf      = "/data/ah3918/projects/scQC-flow/data/resources/downloads/refdata-gex-GRCh38-2024-A/genes/genes.gtf.gz"      // reference GTF

    // 10x chemistry (default: 3v4)
    // Accepted values: 3v2, 3v3, 3v4, 3LT, 5v1, 5v2, 5v3, multiome
    chemistry       = '3v4'

    // Workflow control
    run_ambient     = true   // set to false to skip AMBIENT
    run_qc          = true   // set to false to skip QC (requires run_ambient)
    run_hvg         = false   // set to false to skip HVG selection (requires run_qc)
    run_integration = false  // set to false to skip integration (requires run_hvg)
    run_annotation  = false // set to true to run marker-based annotation (requires run_integration)
    export          = 'none' // export final single-cell objects: none, anndata, seurat, or both

    // HVG selection
    hvg_n_hvgs      = 2000   // number of highly variable genes to select

    // Ambient method / CellBender tuning
    ambient_method = 'cellbender'  // decontx or cellbender
    cellbender_env_name = 'cellbender'  // preinstalled conda env name; empty = use PATH
    cellbender_mig_device = 'MIG-deed3f74-01a1-5c02-95e5-6bbe53383843'  // MIG slice UUID
    cellbender_expected_cells = 0
    cellbender_total_droplets_included = 0
    cellbender_low_count_threshold = 0
    cellbender_learning_rate = 0.0001
    cellbender_empty_drop_training_fraction = 0.2
    cellbender_posterior_batch_size = 0

    // Integration — metadata
    metadata_csv     = '/data/ah3918/projects/scQC-flow/data/metadataFull-14.csv' // path to metadata CSV (required when run_integration = true)
    metadata_id_col  = 'experimentid'  // column in metadata CSV mapping to sample IDs
    metadata_vars    = "brainregion condition brainbank ageatdeath gender"  // space-separated columns for Harmony correction (e.g. 'brainregion condition')

    // Integration — Harmony / clustering / UMAP
    integration_n_dims    = 50    // number of PCA dimensions
    integration_theta     = 0.1   // Harmony theta (diversity penalty)
    integration_leiden_res = '0.1 0.2 0.5 1.0 2.0'  // space-separated Leiden resolutions
    integration_cluster_seed = 42 // seed for Leiden clustering / UMAP layout
    integration_dbl_res   = 4.0   // Leiden resolution for doublet detection pass (high)
    integration_dbl_cl_prop = 0.5 // doublet proportion threshold for cluster exclusion
    exclude_mito          = true  // exclude mito counts from library size denominator

    // Annotation
    annotation_marker_csv = "/data/ah3918/projects/scQC-flow/data/test_annotation_markers.csv"  // long-format CSV: label/symbol or cell_type/marker_gene
    annotation_sel_res = '0.2'    // single clustering resolution from integration_dt.csv.gz
    annotation_min_cl_size = 100
    annotation_min_cells = 10
    annotation_not_ok_re = '(lincRNA|lncRNA|pseudogene|antisense)'
    annotation_min_cpm_mkr = 50
    annotation_top_n = 10
    annotation_fdr_cut = 0.01
    annotation_max_zero_p = 0.5

    // Zoomed subset reruns
    zoom = [
        enabled: false,
        default_sample_min_cells: 10,
        default_hvg_n_hvgs: 2000,
        default_cluster_res: '0.2',
        default_integration_n_dims: 50,
        default_integration_theta: 0.1,
        default_integration_leiden_res: '0.2 0.5 1.0',
        default_integration_dbl_res: 4.0,
        default_integration_dbl_cl_prop: 0.5,
        default_exclude_mito: true,
        default_marker_sel_res: '0.2',
        default_marker_min_cl_size: 100,
        default_marker_min_cells: 10,
        default_marker_top_n: 10,
        default_marker_min_cpm: 50,
        default_marker_fdr_cut: 0.01,
        default_marker_max_zero_p: 0.5,
        items: [
            [
                name: 'dopaminergic_neurons',
                source: 'annotation_label'
            ],
            // For source: 'annotation_label', the zoom name is used as the
            // annotation label by default. Override with label: '...' only if
            // you need a different label string than the output/report name.
            // [name: 'cl01_cl02', source: 'cluster', cluster_res: '0.2', values: ['cl01', 'cl02']]
        ]
    ]

    // QC thresholds — hard baseline (very permissive, removes obvious junk)
    qc_hard_min_counts = 200
    qc_hard_min_feats  = 100
    qc_hard_max_mito   = 0.5

    // QC thresholds — soft per-sample (more stringent)
    qc_min_counts  = 500
    qc_min_feats   = 300
    qc_max_mito    = 0.2
    qc_min_mito    = 0
    qc_max_splice  = 0.6
    qc_min_splice  = 0

    // Execution tuning
    trace_report_suffix = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
}

// Conda channel configuration for tools like simpleaf/alevin-fry.
// Keep conda-forge ahead of bioconda for dependency resolution.
conda {
    channels = ['conda-forge', 'bioconda', 'defaults']
}



// ============================================================================
// EXECUTION ARTIFACT REPORTING
// ============================================================================
// Collect execution logs, timelines, traces, and DAG into a dedicated folder
// within the output directory for easy audit and debugging.

timeline {
    enabled = true
    file = "${params.outputDir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}

report {
    enabled = true
    file = "${params.outputDir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}

trace {
    enabled = true
    file = "${params.outputDir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}

dag {
    enabled = true
    file = "${params.outputDir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

// Cap total CPUs used by the local executor to the available core count
executor {
    cpus = 48
}

// Force per-task CPU requests to stay within node limits
process {
    withLabel: process_high {
        cpus = 48
    }
    withLabel: process_cellbender {
        cpus = 48
    }
    withLabel: process_reports {
        cpus = 48
    }
}
